{
  "name": "personal-ai-os-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "test": "node --test --test-concurrency=1 src/lib/*.test.ts electron/*.test.ts",
    "test:qa": "node qa_visual_test.mjs",
    "build:electron": "tsc -p tsconfig.electron.json && node -e \"const fs=require('fs'); fs.writeFileSync('dist-electron/package.json', JSON.stringify({type:'commonjs'})); if (!fs.existsSync('dist-electron/resources')) fs.mkdirSync('dist-electron/resources', {recursive:true}); for (const f of fs.readdirSync('electron/resources')) fs.copyFileSync('electron/resources/'+f, 'dist-electron/resources/'+f);\"",
    "electron:dev": "node -e \"process.env.NODE_ENV='development'; require('child_process').spawn('npx', ['electron', '.'], {stdio: 'inherit', shell: true})\"",
    "electron:preview": "npm run build && npm run build:electron && node -e \"process.env.NODE_ENV='production'; require('child_process').spawn('npx', ['electron', '.'], {stdio: 'inherit', shell: true})\"",
    "dist": "npm run build && npm run build:electron && electron-builder --win nsis --x64",
    "dist:dir": "npm run build && npm run build:electron && electron-builder --win --dir --x64"
  },
  "build": {
    "appId": "com.personalaios.desktop",
    "productName": "Personal AI OS",
    "directories": {
      "output": "release",
      "buildResources": "electron/resources"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*"
    ],
    "extraResources": [
      {
        "from": "../backend/dist/personal_ai_backend",
        "to": "backend",
        "filter": [
          "**/*"
        ]
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "electron/resources/icon.ico",
      "artifactName": "PersonalAIOS-Setup.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "deleteAppDataOnUninstall": false,
      "createDesktopShortcut": "always",
      "createStartMenuShortcut": true,
      "shortcutName": "Personal AI OS",
      "uninstallDisplayName": "Personal AI OS"
    }
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "framer-motion": "^14.0.0",
    "lucide-react": "^0.453.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwind-merge": "^2.6.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.2",
    "autoprefixer": "^10.4.20",
    "electron": "^44.7.0",
    "electron-builder": "^26.15.3",
    "playwright": "^1.64.0",
    "postcss": "^8.4.47",
    "tailwindcss": "^3.4.14",
    "typescript": "^5.6.3",
    "vite": "^5.4.9"
  }
}
