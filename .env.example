# Application Configuration
APP_NAME="Personal AI OS"
APP_ENV=development
APP_DEBUG=true
HOST=127.0.0.1
PORT=8000
CORS_ORIGINS="http://localhost:5173,http://127.0.0.1:5173"
LOG_LEVEL=INFO

# Database Configuration (SQLite default for local-first zero-cost operation)
DATABASE_URL="sqlite:///./personal_ai_os.db"

# Local LLM Configuration (Ollama)
OLLAMA_BASE_URL="http://127.0.0.1:11434"
OLLAMA_MODEL="qwen3:4b"
OLLAMA_TIMEOUT_SECONDS=120
DEFAULT_LLM_PROVIDER="ollama"

# Future Security & Permission Settings
REQUIRE_APPROVAL_FOR_LEVEL_2=true
REQUIRE_APPROVAL_FOR_LEVEL_3=true
APPROVAL_EXPIRY_SECONDS=300

# Agent & Tool Execution Loop Limits
MAX_TOOL_ITERATIONS=8
