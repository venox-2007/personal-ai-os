# Application Configuration
APP_NAME="Personal AI OS"
APP_ENV=development
APP_DEBUG=true
HOST=127.0.0.1
PORT=8000
CORS_ORIGINS="http://localhost:5173,http://127.0.0.1:5173"
LOG_LEVEL=INFO

# Database Configuration (SQLite default for local-first zero-cost operation)
DATABASE_URL="sqlite:///./personal_ai_os.db"

# Local LLM Configuration (Ollama)
OLLAMA_BASE_URL="http://127.0.0.1:11434"
OLLAMA_MODEL="qwen3:4b"
OLLAMA_TIMEOUT_SECONDS=120
DEFAULT_LLM_PROVIDER="ollama"

# Future Security & Permission Settings
REQUIRE_APPROVAL_FOR_LEVEL_2=true
REQUIRE_APPROVAL_FOR_LEVEL_3=true
APPROVAL_EXPIRY_SECONDS=300

# Agent & Tool Execution Loop Limits
MAX_TOOL_ITERATIONS=8

# Local File Agent Sandbox Configuration
# Comma-separated list of allowed absolute paths for the file agent.
# Example for Windows: FILE_AGENT_ALLOWED_ROOTS="C:/Users/username/Documents,D:/Projects"
# Example for Linux/Mac: FILE_AGENT_ALLOWED_ROOTS="/home/username/Documents,/var/log"
FILE_AGENT_ALLOWED_ROOTS=""

# Study Agent / RAG Settings
STUDY_STORAGE_DIR="./study_data"
STUDY_EMBEDDING_MODEL="all-MiniLM-L6-v2"
STUDY_CHUNK_SIZE=1000
STUDY_CHUNK_OVERLAP=200
STUDY_RETRIEVAL_TOP_K=5
STUDY_MAX_DOC_SIZE_MB=50
